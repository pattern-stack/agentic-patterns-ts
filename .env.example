# Ollama (local GPU)
# OLLAMA_HOST=http://localhost:11434

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# OPENAI_API_KEY=sk-...

# Gateway (Bifrost / any OpenAI-compatible endpoint).
# Setting AP_GATEWAY_BASE_URL routes EVERY agent's declared model through the one
# gateway — no per-provider key needed. Auth is EITHER HTTP Basic OR a bearer key.
# AP_GATEWAY_BASE_URL=https://bifrost.internal/v1
# AP_GATEWAY_BASIC_USER=...
# AP_GATEWAY_BASIC_PASS=...
# AP_GATEWAY_API_KEY=...              # bearer alternative to Basic
# AP_GATEWAY_MODEL_PREFIX=anthropic/  # optional id prefix the gateway expects

# Tier: opus | sonnet | haiku (default: sonnet)
# AGENT_TIER=sonnet
