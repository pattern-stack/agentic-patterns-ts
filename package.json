{
  "private": true,
  "name": "agentic-patterns-ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pattern-stack/agentic-patterns-ts.git"
  },
  "workspaces": ["packages/*", "examples/*"],
  "scripts": {
    "dev": "bun run tools/dev.ts",
    "build": "bun run --filter='*' build",
    "typecheck": "bun run --filter='*' typecheck",
    "test": "bun run --filter='*' test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "bun run build && bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.1.0"
  }
}
