{
  "name": "@agentic-patterns/runtime",
  "version": "0.1.6",
  "description": "Agent execution runtime — runner, events, gates, multi-agent, conversation, exporters",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/pattern-stack/agentic-patterns-ts.git",
    "directory": "packages/agent-runtime"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agents",
    "llm",
    "ai",
    "runtime",
    "vercel-ai-sdk",
    "events",
    "multi-agent"
  ],
  "homepage": "https://github.com/pattern-stack/agentic-patterns-ts",
  "bugs": "https://github.com/pattern-stack/agentic-patterns-ts/issues",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src/"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.0.0",
    "langfuse": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "langfuse": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "dependencies": {
    "@agentic-patterns/core": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "^0.2.0",
    "ai": "^4.0.0",
    "ollama-ai-provider": "^1.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@anthropic-ai/claude-agent-sdk": "^0.2.104",
    "@types/node": "^25.6.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
