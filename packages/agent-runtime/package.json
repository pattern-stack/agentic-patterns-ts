{
  "name": "@pattern-stack/agentic-runtime",
  "version": "0.40.0",
  "description": "Agent execution runtime — runner, events, gates, multi-agent, conversation, exporters",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/pattern-stack/agentic-patterns-ts.git",
    "directory": "packages/agent-runtime"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["agents", "llm", "ai", "runtime", "vercel-ai-sdk", "events", "multi-agent"],
  "homepage": "https://github.com/pattern-stack/agentic-patterns-ts",
  "bugs": "https://github.com/pattern-stack/agentic-patterns-ts/issues",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contract:codex": "vitest run --config vitest.contract.codex.config.ts",
    "test:contract:cc": "vitest run --config vitest.contract.cc.config.ts",
    "lint": "biome check src/"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.0.0",
    "better-sqlite3": "^12.0.0",
    "langfuse": "^3.0.0",
    "vitest": "^3.0.0",
    "zod": "^3.25.0 || ^4.1.8"
  },
  "peerDependenciesMeta": {
    "langfuse": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@pattern-stack/agentic-core": "workspace:^",
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/google": "^4.0.0",
    "@ai-sdk/openai": "^4.0.0",
    "@ai-sdk/openai-compatible": "^3.0.0",
    "@ai-sdk/provider": "^4.0.0",
    "@ai-sdk/provider-utils": "^5.0.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "@anthropic-ai/sdk": ">=0.93.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^7.0.0",
    "ollama-ai-provider-v2": "^1.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.215",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "better-sqlite3": "^12.0.0",
    "msw": "^2.7.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "yaml": "^2.5.0",
    "zod": "^3.25.76"
  }
}
