{
  "name": "@agentic-patterns/runtime",
  "version": "0.0.1",
  "description": "Agent execution runtime — runner, events, gates, multi-agent, conversation, exporters",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/pattern-stack/agentic-patterns-ts.git",
    "directory": "packages/agent-runtime"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src/"
  },
  "peerDependencies": {
    "ai": "^4.0.0",
    "zod": "^3.23.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@langfuse/langfuse": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "dependencies": {
    "@agentic-patterns/core": "workspace:*"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@anthropic-ai/claude-agent-sdk": "^0.2.104",
    "@types/node": "^25.6.0",
    "ai": "^4.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "zod": "^3.23.0"
  }
}
