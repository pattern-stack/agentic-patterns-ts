{
  "name": "@agentic-patterns/cli",
  "version": "0.1.0",
  "description": "agentic — CLI for running agent projects. Crawls ./agents/, wires observability, serves chat + admin dashboard.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/pattern-stack/agentic-patterns-ts.git",
    "directory": "packages/agent-cli"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["agents", "llm", "ai", "cli"],
  "bin": {
    "ap": "./dist/cli.js"
  },
  "files": ["dist", "assets"],
  "scripts": {
    "build": "pnpm build:dashboard && tsup",
    "build:dashboard": "pnpm --filter @agentic-patterns/dashboard build && rm -rf assets/dashboard && mkdir -p assets && cp -r ../agent-dashboard/dist assets/dashboard",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/"
  },
  "dependencies": {
    "@agentic-patterns/core": "workspace:*",
    "@agentic-patterns/runtime": "workspace:*",
    "@agentic-patterns/server": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "@clack/prompts": "^0.8.0",
    "hono": "^4.0.0",
    "tinyglobby": "^0.2.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@agentic-patterns/dashboard": "workspace:*",
    "@types/node": "^25.6.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
